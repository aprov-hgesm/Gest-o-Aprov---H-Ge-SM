rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Connection test document
    match /test/{docId} {
      allow read, write: if true;
    }

    // Military personnel collection
    match /militaries/{militaryId} {
      allow read: if true;
      allow write: if isSignedIn() || request.auth == null;
    }

    // Daily rosters collection
    match /rosters/{rosterId} {
      allow read: if true;
      allow write: if isSignedIn() || request.auth == null;
    }

    // Absences and leaves collection
    match /absences/{absenceId} {
      allow read: if true;
      allow write: if isSignedIn() || request.auth == null;
    }

    // Changelogs / activity history
    match /changelogs/{logId} {
      allow read: if true;
      allow write: if isSignedIn() || request.auth == null;
    }

    // System settings
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isSignedIn() || request.auth == null;
    }
  }
}

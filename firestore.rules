rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function authorizedUser() {
      return request.auth != null &&
        request.auth.token.email == 'aprov1hgesm@gmail.com' &&
        request.auth.token.email_verified == true;
    }
    function validPayload(group, id) {
      let value = request.resource.data.data;
      return value is map && value.id == id &&
        ((group == 'roster' && id == 'principal' &&
          value.militaryList is list && value.absences is list && value.roster is map &&
          value.changelogs is list && value.customHolidays is list) ||
         (group == 'cardapios' && value.dataInicio is string && value.dataFim is string &&
          value.workflow is map && value.dias is list && value.dias.size() == 7) ||
         (group == 'saques' && value.cardapioId is string && value.saqueItemId is string &&
          value.status in ['PENDENTE', 'SEPARADO', 'RETIRADO'] &&
          value.updatedAt is string && value.history is list));
    }
    function validEnvelope(group, id) {
      let value = request.resource.data;
      return value.keys().hasOnly(['data', 'revision', 'mutationId', 'deleted', 'updatedAt', 'schemaVersion']) &&
        value.schemaVersion == 1 && value.revision is int &&
        value.mutationId is string && value.mutationId.size() > 0 &&
        value.mutationId.size() <= 100 && value.deleted is bool &&
        value.updatedAt == request.time && validPayload(group, id);
    }
    match /aprov_workspaces/hgesm/{group}/{id} {
      allow read: if group in ['roster', 'cardapios', 'saques'] && authorizedUser();
      allow create: if authorizedUser() && validEnvelope(group, id) &&
        request.resource.data.revision == 1 && request.resource.data.deleted == false;
      allow update: if authorizedUser() && validEnvelope(group, id) &&
        request.resource.data.revision == resource.data.revision + 1;
      // Tombstones retain revisions and prevent stale clients from recreating deleted records.
      allow delete: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
